package-as: RemoveNameplateDebuffs_Forever

enable-nolib-creation: no

ignore:
  - .ci
  - scripts
  - .gitlab
  - .gitlab-ci.yml
  - .github
  - .gitignore
  - README.md
  - .pkgmeta

plain-copy:
  - LICENSE

manual-changelog:
  filename: docs/CHANGES.md
  markup-type: markdown

license-output: LICENSE